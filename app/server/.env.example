# Copy this file to .env and fill in real values before running
JWT_SECRET=<generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">

# Database Connection (Keep credentials on backend only; never commit .env)
# Development (local unauthenticated instance):
MONGODB_URI=mongodb://localhost:27017/smart_healthcare

# Production (Least-privilege app user with TLS encryption-in-transit):
# MONGODB_URI=mongodb://smart_healthcare_app:<strong_db_password>@db1.internal.example.com:27017,db2.internal.example.com:27017/smart_healthcare?replicaSet=rs0&ssl=true&authSource=smart_healthcare&retryWrites=true&w=majority

PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
DEVICE_API_KEY=<generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">
